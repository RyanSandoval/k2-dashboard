# Names only — no values. Set real values via `vercel env add` or the
# Vercel project dashboard. Never commit actual values.

# Fine-grained GitHub PAT, scoped to RyanSandoval/k2-data only,
# contents: read+write. See spec/vercel-data-layer/PHASE1-TOKEN.md.
GH_TOKEN=

# 32-char random login code, compared in constant time.
ACCESS_CODE=

# 32-byte random hex, HMAC key for signing the session cookie.
SESSION_SECRET=
